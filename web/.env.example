# ==============================================================
# NodePilot HSCC - Frontend Environment Variables (Vercel / Remote)
# ==============================================================
# Leave empty when running embedded in the Go binary or local dev proxy.
# For Vercel deployments, set this to your Home Server's public HTTPS URL
# (e.g., via Cloudflare Tunnel, Tailscale Funnel, or your domain with SSL):
VITE_API_BASE_URL=https://hscc.your-domain.com
